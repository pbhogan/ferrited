# /etc/ferrited/ferrited.env on node 1 (192.0.2.11) of a two-node pair. The app servers are on
# 192.0.2.0/24 with the nodes; 192.0.2.0/24 is a documentation range, so use your own private
# addresses. See docs/operations.md for the reasoning behind each value.
FERRITED_LISTEN=192.0.2.11
FERRITED_PORT=11211
FERRITED_MEMORY_MB=4096
FERRITED_CONN_LIMIT=4096
FERRITED_THREADS=4
FERRITED_NODE_ID=1
FERRITED_REPL_PORT=11212
FERRITED_PEERS=--peer 192.0.2.12:11212
FERRITED_METRICS=--metrics-addr 192.0.2.11:11213
FERRITED_EXTRA_ARGS=--repl-backlog 256m
