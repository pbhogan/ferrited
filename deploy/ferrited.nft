# nftables rules for a ferrited node: /etc/nftables.d/ferrited.nft, or merge into your
# ruleset. Clients only from the app servers, replication only from the other node, metrics
# only from the monitoring host (192.0.2.20 here). Nothing else should reach these ports: the
# client and metrics ports have no authentication, and replication is signed but not encrypted.
# Shown for node 1 (192.0.2.11); on node 2, use 192.0.2.11 as the peer.
#
# This table only restricts: its chain accepts by default, and a packet must be accepted by
# every table it passes through. On a host whose own firewall drops by default (firewalld,
# ufw, an /etc/nftables.conf with policy drop), also open the client port to the app servers,
# the replication port to the other node and the metrics port to the monitoring host in that
# firewall.
table inet ferrited {
	set app_servers {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}

	set monitoring {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.20 }
	}

	chain input {
		type filter hook input priority filter - 1; policy accept;
		tcp dport 11211 ip saddr @app_servers accept
		tcp dport 11211 iifname "lo" accept
		tcp dport 11211 drop
		tcp dport 11212 ip saddr 192.0.2.12 accept
		tcp dport 11212 iifname "lo" accept
		tcp dport 11212 drop
		tcp dport 11213 ip saddr @monitoring accept
		tcp dport 11213 iifname "lo" accept
		tcp dport 11213 drop
	}
}
