# /etc/ferrited/ferrited.env: this node's settings, read by ferrited.service.
# Values are single words except FERRITED_PEERS and FERRITED_EXTRA_ARGS, which are split on
# spaces and may be empty. See docs/operations.md for how to size each one.

# Client address and port; the replication listener uses the same address. ferrited has no
# authentication: use a private address and let the firewall admit only the app servers.
# (192.0.2.0/24 here and in node1.env and node2.env is a documentation range.)
FERRITED_LISTEN=192.0.2.11
FERRITED_PORT=11211

# Cache memory in megabytes (-m). The process uses more: the replication backlog, the oplog and
# connection buffers come on top.
FERRITED_MEMORY_MB=4096

# Most client connections at once (-c). Past it a new connection is refused with an error.
FERRITED_CONN_LIMIT=4096

# Event loop threads serving clients (-t). Others run beside them: Tokio workers for
# replication and timers (at most 4), the log thread, the acceptor, compaction, and Tokio's
# blocking pool for full-sync copies, log segment reads and the expiry sweeper.
FERRITED_THREADS=4

# Replication. Node IDs differ between nodes (1 to 255); every node lists every other node's
# replication address with a --peer each. The secret comes from /etc/ferrited/repl-secret via
# LoadCredential= in the unit.
FERRITED_NODE_ID=1
FERRITED_REPL_PORT=11212
FERRITED_PEERS=--peer 192.0.2.12:11212

# Prometheus metrics at http://<address>/metrics, on the private address; the firewall should
# admit only the monitoring host. Leave it out (or empty) to turn the endpoint off. Its port
# must differ from FERRITED_PORT and FERRITED_REPL_PORT.
FERRITED_METRICS=--metrics-addr 192.0.2.11:11213

# Anything else, such as --fsync-interval-ms or --sync-timeout.
FERRITED_EXTRA_ARGS=--repl-backlog 256m
